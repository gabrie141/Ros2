<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanum_forklift_robot">

  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="light_grey"><color rgba="0.7 0.7 0.7 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.029" rpy="0 0 0"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://mi_montacargas/meshes/base_link.stl" scale="1 1 1"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.129" rpy="0 0 0"/>
      <geometry><box size="0.180 0.180 0.258"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.004392 0.000901 0.097727" rpy="0 0 0"/>
      <mass value="1.224"/>
      <inertia ixx="0.011928" ixy="0.0" ixz="0.0" iyy="0.012725" iyz="0.0" izz="0.007489"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/White</material></gazebo>

  <link name="fork_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://mi_montacargas/meshes/fork_link.stl" scale="1 1 1"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://mi_montacargas/meshes/fork_link.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.029416 -0.000966 -0.017260" rpy="0 0 0"/>
      <mass value="0.051"/>
      <inertia ixx="0.00001971" ixy="0.0" ixz="0.0" iyy="0.00007343" iyz="0.0" izz="0.00008768"/>
    </inertial>
  </link>
  <joint name="fork_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="fork_link"/>
    <origin xyz="0.080 0.0 0.010" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.158" effort="10.0" velocity="0.15"/>
    <dynamics damping="0.5" friction="0.1"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <gazebo reference="fork_link"><material>Gazebo/Grey</material></gazebo>

  <xacro:macro name="mecanum_wheel" params="prefix x_pos y_pos">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mi_montacargas/meshes/wheel.stl" scale="1 1 1"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry><cylinder radius="0.029" length="0.024"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <mass value="0.050"/>
        <inertia ixx="0.00001252" ixy="0.0" ixz="0.0" iyy="0.00001976" iyz="0.0" izz="0.00001252"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_pos} ${y_pos} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.05"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>100.0</mu1>
      <mu2>100.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="fl" x_pos="0.057"  y_pos="0.106"/>
  <xacro:mecanum_wheel prefix="fr" x_pos="0.057"  y_pos="-0.106"/>
  <xacro:mecanum_wheel prefix="rl" x_pos="-0.057" y_pos="0.106"/>
  <xacro:mecanum_wheel prefix="rr" x_pos="-0.057" y_pos="-0.106"/>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.114337 0.0 0.190199" rpy="0.0 -0.10472 0.0"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.000001 -0.000037 0.245700" rpy="0 0 0"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.052144 0.0 0.050044" rpy="0 0 0"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <link name="ultrasonic_left_link"/>
  <joint name="ultrasonic_left_joint" type="fixed">
    <parent link="base_link"/><child link="ultrasonic_left_link"/>
    <origin xyz="0.0 0.093 -0.005204" rpy="0 0 1.570796"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  <link name="ultrasonic_right_link"/>
  <joint name="ultrasonic_right_joint" type="fixed">
    <parent link="base_link"/><child link="ultrasonic_right_link"/>
    <origin xyz="0.0 -0.093 -0.005204" rpy="0 0 -1.570796"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="fl_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
    <joint name="fr_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
    <joint name="rl_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
    <joint name="rr_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mi_montacargas)/config/mecanum_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
